# ---- Telegram (MTProto) -------------------------------------------------
# Get api_id / api_hash from https://my.telegram.org -> API development tools
TG_API_ID=1234567
TG_API_HASH=0123456789abcdef0123456789abcdef

# From @BotFather
BOT_TOKEN=123456:AAAA-bbbbbbbbbbbbbbbbbbbbbbbbbbbb

# OPTIONAL. A user-account session string, required ONLY for files > 2 GB.
# Generate with:  python gen_session.py
# The user account must be a member of the chat the file is posted in.
USER_SESSION=

# ---- Access control -----------------------------------------------------
# Comma-separated numeric Telegram user IDs allowed to use the bot.
# Leave empty to allow nobody (safe default). Use @userinfobot to find yours.
ALLOWED_USERS=

# ---- Google Drive -------------------------------------------------------
# From Google Cloud Console -> APIs & Services -> Credentials
# Create an OAuth client of type "Desktop app".
GOOGLE_CLIENT_ID=xxxxxxxx.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=GOCSPX-xxxxxxxxxxxxxxxx
GOOGLE_TOKEN_FILE=token.json

# Destination folder ID: the part after /folders/ in the Drive URL.
# Leave empty to upload to My Drive root.
DRIVE_FOLDER_ID=

# ---- Runtime ------------------------------------------------------------
DOWNLOAD_DIR=./downloads
# Drive resumable-upload chunk size in MiB. Higher = faster, more RAM.
UPLOAD_CHUNK_MB=16
# Bot accounts cannot download above this. Larger files use USER_SESSION.
BOT_DOWNLOAD_LIMIT_MB=2000
